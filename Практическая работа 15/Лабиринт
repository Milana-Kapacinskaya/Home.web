total = 0
for i in range(5):
    for j in range(5):
        if maze[i*5 + j] == 'м':
            total += 1
print(f"Монет в лабиринте {total} 🟡🟡")

#1.6
LIFE = 100
traps = maze.count('л')
enemies = maze.count('з')
no_life = traps * 10 + enemies * 50
life = max(0, LIFE - no_life)

hearts_full = life // 10
hearts_lost = (LIFE - life) // 10   
print(f"Ловушек: {traps}, врагов: {enemies}, урон: {no_life} HP, осталось: {life} HP")
print("♥" * hearts_full + "♡" * hearts_lost)

