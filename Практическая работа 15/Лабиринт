import random
symbols = '01лмз'
list = [random.choice(symbols) for _ in range(25)]
list[0] = 'н'
list[24] = 'ф'
maze = ''.join(list)
for i in range(0, 25, 5):
    print(maze[i:i+5])

#1.2
for i in range(5):
    for j in range(5):
        if maze[i*5 + j] == 'н':
            row_n, col_n = i, j
            print(f"Координаты входа: строка {row_n}, столбец {col_n}")

#1.3
for i in range(5):
    for j in range(5):
        if maze[i*5 + j] == 'ф':
            row_f, col_f = i, j
            print(f"Координаты выхода: строка {row_f}, столбец {col_f}")

#1.4
distance = abs(row_n - row_f) + abs(col_n - col_f)
print(f"Манхэттенское расстояние: {distance} шагов")

