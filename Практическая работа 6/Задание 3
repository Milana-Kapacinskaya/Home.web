#Вводим коодинаты клеток на шахматной доске
num_post_1, num_line_1 = map(int, input("Введите номер столбца и строки первой клетки от 1 до 8:").split())
num_post_2, num_line_2 = map(int, input("Введите номер столбца и строки второй клетки от 1 до 8:").split())

#Проверяем на схожесть цвета клеток на доске
if not (1 <= num_post_1 <= 8) or not (1 <= num_line_1 <= 8) or not (1 <= num_post_2 <= 8) or not (1 <= num_line_2 <= 8):
    print("Вы ввели число не входящее в диапазон от 1 до 8")
elif (num_post_1 + num_line_1 + num_post_2 + num_line_2) % 2 == 0:
    print("YES")
else:
    print("NO")
