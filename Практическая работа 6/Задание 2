#Ввод числа для определения цвета кармана рулетки
num = int(input("Введите число от 0 до 36:"))

#Определение цвета
if  num ==0 :
    print("Цвет кармана: зеленый")
elif (1 <= num <= 10) or (19 <= num <= 28 ) and num % 2 == 0:
    print("Цвет кармана: черный")
elif (11 <= num <= 18) or (29 <= num <= 36) and num % 2 == 0:
    print("Цвет кармана: красный")
else:
    print("Ошибка, вы вводите число, которое лежит вне диапазона от 0 до 36")
