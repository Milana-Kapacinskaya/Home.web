#Ввод цветов для смешивания
color_1 = input("Введите 1 цвет для смешивания из списка (красный, желтый, синий): ")
color_2 = input("Введите 2 цвет для смешивания из списка (красный, желтый, синий): ")

#Смешивание или вывод ошибки
if color_1 == "красный" and  color_2 == "синий" or color_1 == "синий" and  color_2 == "красный":
    print("Смешанный цвет фиолетовый")
elif color_1 == "красный" and  color_2 == "красный":
    print("Смешанный цвет красный")
elif color_1 == "красный" and  color_2 == "желтый" or color_1 == "желтый" and  color_2 == "красный":
    print("Смешанный цвет оранжевый")
elif color_1 == "желтый" and  color_2 == "желтый":
    print("Смешанный цвет желтый")
elif color_1 == "синий" and  color_2 == "желтый" or color_1 == "желтый" and  color_2 == "синий":
    print("Смешанный цвет зеленый")
elif color_1 == "синий" and  color_2 == "синий":
    print("Смешанный цвет синий")
else:
    print("Ошибка, вы ввели цвет или цвета, не входящие в список (красный, желтый, синий)")
