max = 0 #Начальное значение
while True: #Бесконечный цикл на присваивания макс значения числу
    num = int(input("Введите число: "))

    if num == 0:
        break #выход из программы, если соответствует это условие
    elif num > max:
        max = num #Присваивания макс, если соответствует условие
    else:
        print() #Переход на новый цикл

print(f"Максимальное число из введенных: {max}") #вывод макс, запомненного при работе цикла до его остановки
