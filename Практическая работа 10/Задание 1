PIN_ZAM = 4590
print("ЭЛЕКТРОННЫЙ ЗАМОК")
while True: #Бесконечный цикл
    pin = int(input("Введите пин-код: ")) #Ввод данных

    if pin == PIN_ZAM: #Проверка веденных данных на условие
        break #Выход из цикла, если даннные сходятся
    else:
        print("Ошибка. Попробуйте еще раз") #Данные не сходятся, уход на новый круг цикла

print("Доступ разрешен") #При выходе из цикла, вывод данных
