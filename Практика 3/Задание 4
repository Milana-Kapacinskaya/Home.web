1.  int (число целое студентов)
2.  float (значение температуры с бегающей точкой)
3.  str (простой текст)
4.  bool (ответ на вопрос да/нет, true/false)
5.  list (изменяемый список, в котором можно добавить, убрать данные)
6.  tuple (фиксированные данные, которые невозможно изменить)
7.  set (множество уникальных товаров)
8.  dict (хранение информации: понятие - значение; парами)
