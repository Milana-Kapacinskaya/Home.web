n = int(input("Введите количество строк: ")) #Ввод количества строк
list = [] #Создание пустого списка

for _ in range(n): #Цикл ввода строк
    srt = input("Введите элементы или элементы: ") #Ввод элемента, строка
    list.extend(srt) #Ввод каждого элемента строки в список

print(list) #Вывод полученного списка
