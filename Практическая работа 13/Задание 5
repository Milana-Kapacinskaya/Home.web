number_pairs = input("Введите число пар через пробел: ") #Ввод количества пар
num_pairs = number_pairs.split(' ') #Организация списка за счет пробела между числа, каждое число отдельный элемент списка
total = 0

for i in range(len(num_pairs)): #Внешний цикл, работает от 0 до длины списка пар
    for j in range(i+1, len(num_pairs)): #Внутренний цикл, работает от 1 до длины списка пар
        if num_pairs[i] == num_pairs[j]: #Сравнения пар на схожесть, через индекс чисел
            total += 1 #Увеличения счетчика, если находят схожие

print(f"{total} - количество схожих пар")
