num_IP = input("Введите четыре числа IP-адреса, разделяя каждое точкой: ") #Ввод числа
nums = num_IP.split(".")#Разбивание строки через ., делая из этого список
total = 0

for num in nums: #Проверка каждого элемента в списке
    num = int(num) #Преобразования элементра списка формата строки в цисло
    if 0 <= num <= 255: #Проверка этого числа
        total += 1 #Увеличения счетчика

if total == 4 and len(nums) == 4: #Проверка данных и вывод результата
    print(f"ДА, {num_IP} - правильный адрес")
else:
    print(f"НЕТ, {num_IP} - некорректный адрес")
