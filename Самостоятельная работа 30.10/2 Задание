word_1 = set(input("Введите слово: "))
word_2 = set(input("Введите слово: "))

attendance_1 = word_1 & word_2
attendance_2 = word_1.difference(word_2)
attendance_3 = word_2.difference(word_1)
attendance_4 = word_1 | word_2

print(f"Общие: {attendance_1}")
