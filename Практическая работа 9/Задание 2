#Ввод первого имени и начального значения счетчика
name = input("Введите имя: ")
total = 0
#Цикл пока...
while name != "Левон":
    if name == "Левон": #Условие в цикле
        print(f"Число человек в очереди: {total} ")
        break #Вывод из цикла
    total += 1 #Счетчик человек в очереди
    name = input("Введите имя: ")
print(f"Число человек в очереди: {total} ") #Вывод человек в очереди
