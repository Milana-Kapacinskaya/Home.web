i = 1 #Ввод начального значения для работы цикла
n = int(input()) #Ввод граничного числа
while i <= n: #Цикл пока...
    if 5 <= i <= 9 or 17 <= i <= 37 or 78 <= i <= 87: #Условие цикла
        i += 1 #Если условие выполнятся
        continue #Переход к следующей операции цикла без вывода
    print(i) #Вывод данных, кроме условия
    i += 1 #Счетчик
