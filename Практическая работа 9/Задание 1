num = 1 #Ввод начального значения для работы цикла
n_num = int(input("Введите число: ")) #Ввод граничного числа
while num <= n_num: #Цикл пока...
    if 5 <= num <= 9 or 17 <= num <= 37 or 78 <= num <= 87: #Условие цикла
        num += 1 #Если условие выполнятся
        continue #Переход к следующей операции цикла без вывода
    print(num) #Вывод данных, кроме условия
    num += 1 #Счетчик
