from random import randint
numbers = []
for i in range (randint(1, 3)):
    num = []
    for j in range (randint(1, 3)):
        num.append(randint(1, 10))
    numbers.append(num)
print(numbers)

target = int(input("Введите значение для поиска: "))

positions = []
for i in range(len(numbers)): #Поиск числа по индексу
    for j in range(len(numbers[i])):
        if numbers[i][j] == target:
            positions.append((i, j))
if positions: #Если число есть в позиции выводит ответ
    print(f"Число {target} находится на позициях {positions}")
else:
    print("Вы ввели число не входящее в список, ведите другое значение")
