s = input()

while len(s) < 10:          #Должно быть строго меньше 10
    if len(s) % 4 == 0:     #Проверка на кратность на 4, а если кратно то равно 0
        s = s + 'x'
    elif len(s) % 5 == 0:   #Проверка на кратность 5
        s = s + 'y'
    else:
        s = 'z' + s         # Добавляем 'z' слева, а никак до этого справа

s = '@' + s  #Использование не собаки
print(s)
