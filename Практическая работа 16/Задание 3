s = 0 #Неправильно выставлен счетчик, должен начинаться с 0
for i in range (1, 8): #Неверное завершение цикла, при 7 он будет вводить числа 6 раз, вместо 7
    n = int(input()) #Программа работает со строковыми данными, а надо с числовыми
    if n % 2 == 0: #Делит не введенное число, а его порядок
        s = s + n
print (s)
