n = int(input()) #Добавила тип введенной переменной
product = 1 #Заменила действия строки, на присвоение начального значения счетчика
while n > 0: #Неправильное ограничение работы цикла. Заменила работу цикла, чтобы последнее однозначное число тоже умножалось и входило в счетчик
    digit = n % 10
    product = product * digit
    n //= 10
print(product)
