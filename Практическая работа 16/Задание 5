n = int(input())
max_digit = -1  #Значение счетчика выставлено последним элементом числа, а нужно -1, тк 0 кратно 3
while n > 0:
    digit = n % 10
    if digit % 3 == 0:
        if digit > max_digit:  # Ищем минимум, а нужно максимум
            max_digit = digit  #Присваиваем неправильно значение
    n = n // 10  #Оставляем остаток от числа, а нужно переходить к следующей цифре
if max_digit == -1: #Возможно встретиться 0, а 0 делиться на 3
    print('NO')
else:
    print(max_digit)
