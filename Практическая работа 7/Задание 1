#Система для определения рейтинга продукта
#Ввод номера рейтинга для определения качества продукта
num_rank = int(input("Введите числовой рейтинг продукта (от 1 до 10): "))

#Отпределения рейтинга продукта через match-case
match num_rank:
    case 10 | 9 :
        print(f"Рейтинг {num_rank} → 'Отличный продукт! 🌟 Настоятельно рекомендую'")
    case 8 | 7 :
        print(f"Рейтинг {num_rank} → 'Хороший продукт! 👍 Рекомендую'")
    case 6 | 5 | 4:
        print(f"Рейтинг {num_rank} → 'Средний продукт! 😐 Можно попробовать'")
    case 3 | 2 | 1:
        print(f"Рейтинг {num_rank} → 'Плохой продукт! ❌ Не рекомендую'")
    case _:
        print("Ошибка. Вы ввели некорректные данные, введите число от 1 до 10")
