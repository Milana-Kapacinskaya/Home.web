finish = "YES"
for _ in range(10):
    num = int(input("Введите число:")) #Ввод чисел в пустой цикл 10 раз 
    if num % 2 != 0: #Проверка каждого введенного числа на четность или нечетность, программа запоминает полученный результат
        finish = "NO"
#Вывод результата, который запомнила программа в течении действий или изначально
print(finish)
