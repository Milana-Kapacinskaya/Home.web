#Ввод числа для определения суммы с помощью количества чисел
num = int(input("Введите число:"))
total = 0
#Вычисление суммы с помощью цикла
for i in range(1,num+1):
    if i % 2 != 0:
        total += i
    else:
        total -= i
#Вывод полученной суммы
print(f"Знакопеременная сумма числа равна {total}")
