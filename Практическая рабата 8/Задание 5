n = int(input("Введите число больше или равно 2: "))
max_1 = 0
max_2 = 0
if n >= 2: #Соответствие условию
    for _ in range(n): #Повтор цикла n раз
        num = int(input("Введите число последовательности: ")) #Ввод числа
        if num > max_1: #Присвоение числу либо мах, либо мин, в процессе цикла числа меняются
            max_2 = max_1
            max_1 = num
        elif num > max_2:
            max_2 = num
        else:
            print()
    print(f"Первое макс число из последовательности: {max_1}") #Вывод мах
    print(f"Второе макс число из последовательности: {max_2}") #Вывод мин
else:
    print("Ошибка. Вы ввели число меньше 2!") #Вывод, если данные не соответствуют условию
