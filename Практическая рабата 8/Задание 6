import random
num = random.randint(1, 10) #загадка числа
for i in range (3):
    num_my = int(input("Введите число: ")) #Ввод числа в цикле 3 раза,
    if num_my == num :
        print("Угадали!") #Проверка угадали число или нет
        break
#Если не угадали, куда двигаться
    elif num < num_my:
        print("Вы не угадали число. Попробуйте двигаться в меньшую сторону")
    else:
        print("Вы не угадали число. Попробуйте двигаться в большую сторону")
#Вывод загаданного числа
print(f"Загаданное число: {num}")
