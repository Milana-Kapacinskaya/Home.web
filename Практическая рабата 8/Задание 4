#Ввод данных
m = int(input("Введите стартовое количество организмов: "))
p = int(input("Введите средне суточное увеличение в процентах: "))
n = int(input("Введите количество дней для размножения: "))
total = m
#Работа цикла, на вычисление популяции с помощью сложного процента
for i in range(1,n+1):
    total *= 1 + p/100
    print(f"День {i} размер {total:.2f} популяции") #Вывод каждого цикла, после работы всего
