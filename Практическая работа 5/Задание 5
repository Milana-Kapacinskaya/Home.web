PI = 3.14159
#Функции для расчета площедей
def calculate_rectangle_area(width, length):
    """
    Функция принимает значения длины и ширины прямоугольника width, length
    далее находит площадь прямоугольника area_rectangle и выводит
    результат (значение площади прямоугольника) return:area_rectangle
    """
    area_rectangle = width * length
    return area_rectangle
def calculate_circle_area(radius):
    """
    Функция принимает значение радиуса круга radius, далее
    находит площадь круга area_round, учитывая константу PI и выводит
    результат (значение площади круга) return:area_round
    """
    area_round = PI * radius ** 2
    return area_round

#Ввод значений длины и ширины прямоугольника
a, b = map(float, input("Введите ширину и длину прямоугольника:").split())
#Вывов функции для нахождения площади прямоугольника
area_rectangle_1 = calculate_rectangle_area(a, b)
#Вывод на экран полученного значений площади прямоугольника
print("Площадь прямоугольника равна:", area_rectangle_1)
#Ввод значений радиуса круга
r = float(input("Введите радиус круга:"))
#Вывов функции для нахождения площади круга
area_round_1 = calculate_circle_area(r)
#Вывод на экран полученного значения площади круга
print(f"Площадь круга равна: {area_round_1:.2f}")
